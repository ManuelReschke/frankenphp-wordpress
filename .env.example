# Local dev: http://localhost (plain HTTP on mapped port 8080).
# Production: example.com (Caddy automatic HTTPS/TLS).
SERVER_NAME=http://localhost
# Database
MYSQL_DATABASE=franken
MYSQL_USER=frankenuser
MYSQL_PASSWORD=frankenpass
MYSQL_ROOT_PASSWORD=rootpass
# Redis/Dragonfly
REDIS_HOST=dragonfly
REDIS_PORT=6379
DRAGONFLY_MAX_MEMORY=512mb
# -----------------------------------------------------------------------------
# Permissions (bind-mounted ./wordpress)
# -----------------------------------------------------------------------------
# FrankenPHP and PHP run as HOST_UID:HOST_GID inside the container so the
# WordPress volume stays editable on the host (same owner as your user).
# Uploads, plugin/theme installs, and host edits then share one ownership.
#
# Set these to your host user (do not use www-data / 33 in dev):
#   id -u   →  HOST_UID
#   id -g   →  HOST_GID
#
# After changing values: make up
# If ownership drifted (e.g. old setup with www-data): make fix-perms
#   or: make fix-perms-host  (writes current id -u/-g into this file + chown)
# Optional one-shot in container: FORCE_CHOWN=1
HOST_UID=1000
HOST_GID=1000
